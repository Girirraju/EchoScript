pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  stages {
    stage('Validate') {
      parallel {
        stage('Terraform') { steps { sh 'terraform fmt -check -recursive infrastructure/terraform'; sh 'for d in infrastructure/terraform/account*; do terraform -chdir=$d init -backend=false && terraform -chdir=$d validate; done' } }
        stage('Ansible') { steps { sh 'ansible-playbook --syntax-check infrastructure/ansible/playbooks/site.yml' } }
        stage('Security') { steps { sh 'checkov -d infrastructure/terraform --quiet' } }
      }
    }
    stage('Plan') { steps { withAWS(role: env.TERRAFORM_ROLE_ARN, roleSessionName: "jenkins-${BUILD_NUMBER}") { sh './ci/scripts/terraform-plan.sh' } } }
    stage('Approval') { steps { input message: 'Apply reviewed infrastructure plans?', ok: 'Apply' } }
    stage('Apply') { steps { withAWS(role: env.TERRAFORM_ROLE_ARN, roleSessionName: "jenkins-${BUILD_NUMBER}") { sh './ci/scripts/terraform-apply.sh' } } }
  }
}

